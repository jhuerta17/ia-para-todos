{
  "name": "ia-para-todos-website",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:admin-css": "tailwindcss -i src/app/admin/admin-theme.css -o public/admin-theme.css --minify",
    "prebuild": "npm run build:admin-css",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "install:chromium": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers npx -y playwright@1.64.1 install chromium",
    "verify:forms": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers node scripts/verify-forms.headless.mjs",
    "verify:forms:headed": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers HEADED=1 node scripts/verify-forms.headless.mjs",
    "verify:transitions": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers node scripts/verify-transitions.headless.mjs",
    "verify:transitions:headed": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers HEADED=1 node scripts/verify-transitions.headless.mjs",
    "verify:ai": "node scripts/verify-ai-assist.mjs",
    "verify:admin": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers node scripts/verify-admin.headless.mjs",
    "verify:admin:headed": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers HEADED=1 node scripts/verify-admin.headless.mjs",
    "verify:portal": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers node scripts/verify-portal.headless.mjs",
    "review:portal": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers REVIEW_PORTAL=1 node scripts/verify-portal.headless.mjs",
    "verify:portal:headed": "PLAYWRIGHT_BROWSERS_PATH=../.playwright-browsers HEADED=1 node scripts/verify-portal.headless.mjs",
    "watch": "ng build --watch --configuration development",
    "verify:ai:types": "tsc --ignoreConfig --strict --noEmit --allowImportingTsExtensions --target ES2022 --module nodenext --types node --skipLibCheck netlify/functions/ai-assist.mts netlify/functions/ai-status.mts netlify/functions/ai-control.mts netlify/lib/ai-security.mts"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.1",
    "@netlify/blobs": "11.1.7",
    "@netlify/identity": "2.0.0",
    "gotrue-js": "1.0.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@netlify/functions": "6.0.3",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
